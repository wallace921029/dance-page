# 本地开发配置。复制为 backend/.env 后使用
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 本地用 http 访问，Cookie 不能带 Secure
COOKIE_SECURE=false

# ---- AI 服务商凭据（D82）：修改后重启服务生效；不用的服务商可以留空 ----
# 阿里云百炼：百炼控制台 → API Key（以 sk- 开头）
DASHSCOPE_API_KEY=
# 火山引擎方舟：方舟控制台 → API Key，用于故事与台词识别、动画视频
VOLCENGINE_ARK_API_KEY=
# 火山引擎豆包语音：豆包语音控制台（新版）里的 API Key，用于朗读；与方舟的 Key 不是同一个
VOLCENGINE_SPEECH_API_KEY=
