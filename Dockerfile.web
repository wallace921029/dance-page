# 前端镜像：构建 React 单页应用，再用 Nginx 托管，并把 /api 转发给后端（docker-compose.yml 里的 web 服务）
FROM node:24 AS build

# npm 仓库地址。国内服务器访问官方仓库很慢，可以在 .env 里设 NPM_REGISTRY=https://registry.npmmirror.com
ARG NPM_REGISTRY=https://registry.npmjs.org

WORKDIR /app

# 先只装依赖，源码改动时可以复用这一层缓存（package-lock.json 里记的是官方地址，npm 会自动换成上面的仓库）
COPY package.json package-lock.json ./
RUN npm config set registry "$NPM_REGISTRY" && npm ci

COPY index.html tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts components.json ./
COPY public ./public
COPY src ./src
# tsc -b 类型检查 + vite build
RUN npm run build


FROM nginx:stable-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
