# docker compose 使用的部署配置。复制为 .env 后修改（.env 不会提交到仓库）

# 管理员账号密码：每次启动时同步到数据库，修改后重启即生效（已登录的管理员设备需重新登录）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 会话 Cookie 是否只在 HTTPS 下发送。Nginx 未配置 HTTPS、用 http:// 访问时必须设为 false
COOKIE_SECURE=true

# 上传大小上限（MB）
MAX_UPLOAD_MB=200

# ---- AI 服务商凭据（D82）：修改后重启服务生效；不用的服务商可以留空 ----
# 阿里云百炼：百炼控制台 → API Key（以 sk- 开头）
DASHSCOPE_API_KEY=
# 火山引擎方舟：方舟控制台 → API Key，用于故事与台词识别、动画视频
VOLCENGINE_ARK_API_KEY=
# 火山引擎豆包语音：豆包语音控制台（新版）里的 API Key，用于朗读；与方舟的 Key 不是同一个
VOLCENGINE_SPEECH_API_KEY=

# API 在本机监听的端口（Nginx 转发到这里）
API_PORT=8000
