# docker compose 使用的部署配置。复制为 .env 后修改（.env 不会提交到仓库）

# 管理员账号密码：每次启动时同步到数据库，修改后重启即生效（已登录的管理员设备需重新登录）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 会话 Cookie 是否只在 HTTPS 下发送。Nginx 未配置 HTTPS、用 http:// 访问时必须设为 false
COOKIE_SECURE=true

# 上传大小上限（MB）
MAX_UPLOAD_MB=200

# AI 阶段用于加密保存 API Key，请设为一串足够长的随机字符
APP_SECRET_KEY=

# API 在本机监听的端口（Nginx 转发到这里）
API_PORT=8000
