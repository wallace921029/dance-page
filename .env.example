# docker compose 使用的部署配置。复制为 .env 后修改（.env 不会提交到仓库）
# 用法：cp .env.example .env，改好下面的内容，然后 docker-compose up -d

# 管理员账号密码：每次启动时同步到数据库，修改后重启即生效（已登录的管理员设备需重新登录）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 会话 Cookie 是否只在 HTTPS 下发送。Nginx 未配置 HTTPS、用 http:// 访问时必须设为 false
COOKIE_SECURE=true

# 上传大小上限（MB）
MAX_UPLOAD_MB=200

# ---- AI 服务商凭据（D82）：修改后重启服务生效；不用的服务商可以留空 ----
# 阿里云百炼：百炼控制台 → API Key（以 sk- 开头）
DASHSCOPE_API_KEY=
# 火山引擎方舟：方舟控制台 → API Key，用于故事与台词识别、动画视频
VOLCENGINE_ARK_API_KEY=
# 火山引擎豆包语音：豆包语音控制台（新版）里的 API Key，用于朗读；与方舟的 Key 不是同一个
VOLCENGINE_SPEECH_API_KEY=

# ---- 一键部署（docker-compose up -d）----
# 网站对外的端口：访问 http://服务器:8080
WEB_PORT=8080
# 监听的网卡。默认对外开放；前面有自己的 Nginx（域名、HTTPS）时改成 127.0.0.1，再让 Nginx 转发到上面的端口
WEB_BIND=0.0.0.0
# 数据目录（数据库、原始 PDF、页面图、AI 产物）在宿主机上的位置；备份这个目录即可
DATA_PATH=./data

# 各容器的内存上限（不允许用 swap，超了容器会被杀掉并自动重启，不会拖垮整台服务器）。默认值按 2 核 4G 的服务器定；
# PDF 拆页最吃内存，服务器内存更大时可以调高 WORKER_MEM_LIMIT
# API_MEM_LIMIT=768m
# WORKER_MEM_LIMIT=2g
# WEB_MEM_LIMIT=256m

# 构建前端镜像时用的 npm 仓库。国内服务器访问官方仓库很慢，取消下面这行的注释即可换成国内镜像
# NPM_REGISTRY=https://registry.npmmirror.com
